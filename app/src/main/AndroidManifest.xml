<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility, API 30+. We need to resolve two things about apps other than
      our own: their name, for the per-app switch list, and whether they have a launcher
      entry, which is how JapaneseScout tells a real app from the system UI or a keyboard.
      Declaring the launcher intent covers exactly those apps. QUERY_ALL_PACKAGES would
      also work and is both wider than we need and restricted on Play.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
          The LLM's GPU backend reaches OpenCL through dlopen. libOpenCL.so is a vendor
          public library, and from API 31 those have to be named here or the load fails
          with "Can not find OpenCL library on this device" even where the file exists.
          Not required: a device without it falls back to the CPU backend, and one
          without the model never loads the runtime at all.
        -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TranslatorService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
